// =============================================
// КОМПОНЕНТЫ OEE И БАЗОВЫЕ ФОНДЫ ВРЕМЕНИ
// =============================================

Календарный_Фонд_мин = 
COUNTROWS('Лог_Состояний_OEE') * 720

Время_Работы_мин = 
SUM('Лог_Состояний_OEE'[Время_Работа_мин])

Время_Простоев_мин = 
SUM('Лог_Состояний_OEE'[Время_Простой_мин])

Доступность = 
DIVIDE([Время_Работы_мин], [Календарный_Фонд_мин], 0)

Качество = 
DIVIDE(
    SUM('Лог_Состояний_OEE'[Годные_шт]), 
    SUM('Лог_Состояний_OEE'[Произведено_Всего_шт]), 
    0
)

Производительность = 
VAR TotalIdealTimeSec = 
    SUMX(
        'Лог_Состояний_OEE',
        'Лог_Состояний_OEE'[Произведено_Всего_шт] * RELATED('Справочник_Оборудование'[Идеальное_Время_Цикла_сек])
    )
VAR ActualRunningTimeSec = [Время_Работы_мин] * 60
RETURN
    DIVIDE(TotalIdealTimeSec, ActualRunningTimeSec, 0)

OEE_Итоговый = 
[Доступность] * [Производительность] * [Качество]


// =============================================
// TIME INTELLIGENCE И ДИНАМИКА OEE
// =============================================

OEE_Прошлый_Месяц = 
CALCULATE(
    [OEE_Итоговый],
    DATEADD('Календарь'[Date], -1, MONTH)
)

Изменение_OEE_MoM = 
[OEE_Итоговый] - [OEE_Прошлый_Месяц]

Простои_Накопительным_Итогом_YTD = 
TOTALYTD([Время_Простоев_мин], 'Календарь'[Date])


// =============================================
// МЕТРИКИ НАДЕЖНОСТИ (ТОиР)
// =============================================

Количество_Отказов = 
COUNTROWS('Лог_Ремонтов_ТОиР')

MTBF_Часы = 
DIVIDE(
    [Время_Работы_мин] / 60,
    [Количество_Отказов],
    0
)